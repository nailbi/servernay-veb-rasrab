APP_NAME="Учебный сайт"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Moscow
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

# Очередь (ЛР10): задания хранятся в таблице jobs, запуск — php artisan queue:work
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

DB_CONNECTION=sqlite
APP_FAKER_LOCALE=ru_RU

# Почта (ЛР8). log — письма пишутся в storage/logs/laravel.log.
# Для настоящей отправки через mail.ru поставьте MAIL_MAILER=smtp
# и укажите логин и пароль для внешних приложений.
MAIL_MAILER=log
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=test@mospolytech.ru
MAIL_FROM_NAME="${APP_NAME}"
